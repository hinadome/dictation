# HTTPS FrontendGateway for dictation.
# Placeholders: __DOMAIN__ __ROOT__ __SSL_DIR__

# ACME HTTP-01 challenge + optional redirect
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     __SSL_DIR__/fullchain.pem;
    ssl_certificate_key __SSL_DIR__/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    root __ROOT__;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "credentialless" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location ~* \.(js|css|wasm|svg|png|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public";
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "credentialless" always;
        try_files $uri =404;
    }
}
